# These NEXT_PUBLIC values are embedded during `next build`.
# Restrict the browser key by exact website referrers and Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# Used at build time to allow and optimize server-issued rental image URLs.
CDN_BASE_URL=
