# FindMe staging environment template.
#
# Copy to `.env.staging` (git-ignored) and fill in real values:
#   cp .env.staging.example .env.staging
# Then run:
#   docker compose --env-file .env.staging -f deploy-part/compose.staging.yaml up --build --detach --wait
#
# Every value below is interpolated by deploy-part/compose.staging.yaml. The
# `${NAME:?...}` entries fail the Compose run when empty, so this file is a
# checklist rather than a set of defaults. Never commit real staging secrets.
# See docs/DEPLOYMENT.md for the full runbook.

# ---------------------------------------------------------------------------
# Public origins (all HTTPS in staging)
# ---------------------------------------------------------------------------
# Browser API base. Build-time value baked into the Next.js bundle.
NEXT_PUBLIC_API_BASE_URL=https://api.staging.example.com/api/v1
# API address reachable from inside the frontend container (container network,
# loopback, or a private host address - not the public hostname unless it
# resolves from inside the container).
API_INTERNAL_BASE_URL=http://backend:3001/api/v1
# Public website origin. Used for canonical and Open Graph rental URLs, and as
# the backend WEB_ORIGIN allowed-browsers origin.
SITE_URL=https://staging.example.com
WEB_ORIGIN=https://staging.example.com

# ---------------------------------------------------------------------------
# Build/runtime binding
# ---------------------------------------------------------------------------
# Loopback by default. Set to 0.0.0.0 only when a host reverse proxy or a
# container network requires it, and never expose plain HTTP publicly.
STAGING_BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# Google Maps
# ---------------------------------------------------------------------------
# Browser key: website/restriction limited to the exact staging origin.
# Server key: separate key, restricted by backend egress IP and allowed APIs.
# Map ID: JavaScript map ID from the same Google Cloud project as the browser key.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_SERVER_KEY=

# ---------------------------------------------------------------------------
# Database (Neon) and Redis (managed)
# ---------------------------------------------------------------------------
# Pooled connection string for the running API.
DATABASE_URL=
# Direct/unpooled connection string. Migrations require this; Neon's pooled
# connection cannot run DDL reliably.
DATABASE_URL_UNPOOLED=
# Managed Redis. Required in staging for caching, rate limits, and queues.
REDIS_URL=
# Comma-separated reverse proxy IPs/CIDRs only. Empty means direct connections.
# Never trust a blanket or untrusted client network. See docs/RATE-LIMITS.md.
TRUSTED_PROXY_CIDRS=

# ---------------------------------------------------------------------------
# Authentication secrets
# ---------------------------------------------------------------------------
# At least 32 characters each, different from each other, and no placeholder
# text containing "replace-with" or "change-before-deploying" - staging startup
# rejects placeholders. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
REFRESH_TOKEN_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# One of debug, info, warn, error. Defaults to info in staging.
LOG_LEVEL=info
# Optional. At least 32 characters; enables GET /api/v1/health/metrics.
# Leave empty to keep the ops metrics route absent.
OPS_METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Object storage (all or nothing in staging)
# ---------------------------------------------------------------------------
# S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY and CDN_BASE_URL
# must be set together; startup fails otherwise. Configure bucket CORS for
# signed browser PUT requests from the exact staging frontend origin.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Optional Google sign-in
# ---------------------------------------------------------------------------
# Set both or leave both empty. Register
# {NEXT_PUBLIC_API_BASE_URL origin}/api/v1/auth/google/callback as the exact
# authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=

# ---------------------------------------------------------------------------
# Optional Telegram
# ---------------------------------------------------------------------------
# Inquiry alerts: set the token and chat ID together or leave both empty.
# Chat ID is numeric (e.g. -1001234567890) or an @username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INQUIRIES_CHAT_ID=
# Administrator support bot stays off until this lists numeric Telegram user
# ids. When set, TELEGRAM_WEBHOOK_SECRET is also required in staging and
# TELEGRAM_SUPPORT_POLLING must remain false (compose pins it to false).
TELEGRAM_SUPPORT_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=
