# Shared runtime mode
NODE_ENV=development
APP_ENV=local

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# Public by design. Use a website/referrer-restricted browser key.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Use a JavaScript map ID from the same Google Cloud project as the browser key.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Backend
PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://findme:findme_local@localhost:5432/findme
# Use a direct Neon connection for migrations. For local PostgreSQL it matches DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://findme:findme_local@localhost:5432/findme
# Optional non-production database used by Prisma when diffing migration history.
SHADOW_DATABASE_URL=postgresql://findme:findme_local@localhost:5432/findme_shadow
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-long-local-development-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-long-local-development-secret
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# Secret. Restrict this separate key by server egress IP and API.
GOOGLE_MAPS_SERVER_KEY=

# Object storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
