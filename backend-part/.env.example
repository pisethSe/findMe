PORT=3001
WEB_ORIGIN=http://localhost:3000
# JSON request-log threshold: debug, info, warn, or error.
# Defaults to info in staging/production and warn in local/test.
LOG_LEVEL=
# Optional. When set, enables GET /api/v1/health/metrics for infrastructure
# scrapers. Use at least 32 characters; leave empty to disable the route.
OPS_METRICS_TOKEN=
DATABASE_URL=postgresql://findme:findme_local@localhost:5432/findme
DATABASE_URL_UNPOOLED=postgresql://findme:findme_local@localhost:5432/findme
SHADOW_DATABASE_URL=postgresql://findme:findme_local@localhost:5432/findme_shadow
# Optional in local/test; required in staging/production for caching and rate limits.
REDIS_URL=redis://localhost:6379
# Empty means direct connections; set only the actual reverse proxy IPs/CIDRs.
TRUSTED_PROXY_CIDRS=
JWT_ACCESS_SECRET=replace-with-a-long-local-development-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-long-local-development-secret
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# Required outside local/test. Keep secret and restrict by egress IP and API.
GOOGLE_MAPS_SERVER_KEY=
# Optional Google sign-in. Leave both empty for email/password-only sign-in.
# Register {API_ORIGIN}/api/v1/auth/google/callback as the redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Exact redirect URI registered with Google; local development falls back to
# the API request origin when this is unset.
GOOGLE_OAUTH_REDIRECT_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
S3_FORCE_PATH_STYLE=false
